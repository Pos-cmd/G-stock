{
  "name": "G-stock",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev",
    "db:push": "vp run --filter @G-stock/db db:push",
    "db:studio": "vp run --filter @G-stock/db db:studio",
    "db:generate": "vp run --filter @G-stock/db db:generate",
    "db:migrate": "vp run --filter @G-stock/db db:migrate",
    "db:migrate:fresh": "node scripts/migrate-fresh.mjs",
    "db:restore": "node scripts/restore-backup.mjs",
    "demo:seed": "jiti packages/api/scripts/seed-demo.ts",
    "dev:demo": "node scripts/dev-demo.mjs",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/web && pnpm run auth:generate",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@G-stock/config": "workspace:*",
    "@types/node": "^26.4.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "rolldown": "1.2.15",
    "typescript": "catalog:",
    "ultracite": "8.0.0",
    "varlock": "catalog:",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "@vue/devtools-api": "^8.2.1"
  },
  "packageManager": "pnpm@10.28.2"
}
