# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Les valeurs propres à chaque poste sont `@dynamic=boot` : l'application de bureau fige le reste
# de la config au build (`varlock freeze`) et les fournit au lancement du serveur.

# @dynamic=boot @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic=boot @type=url
BETTER_AUTH_URL=

# Autres adresses autorisées à se connecter, séparées par des virgules. Ex. l'adresse Tailscale
# du PC (https://mon-pc.tail1234.ts.net) pour ouvrir G-stock depuis un téléphone.
# @optional @public @dynamic=boot
TRUSTED_ORIGINS=

# @dynamic=boot @type=string(minLength=1)
DATABASE_URL=
